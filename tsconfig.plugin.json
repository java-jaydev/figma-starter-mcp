{
  "compilerOptions": {
    "target": "ES2017",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "lib": ["ES2017"],
    "types": ["@figma/plugin-typings"]
  },
  "include": ["src/plugin/**/*.ts", "src/shared/**/*.ts"],
  "exclude": ["src/plugin/ui/**"]
}
